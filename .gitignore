# UkePack output / 使用者素材（避免誤推授權音檔）
uploads/
exports/
*.mp3
*.wav
*.mid
*.midi
*.musicxml
*.mxl
*.pdf
!docs/**/*.pdf
!samples/public_domain/**/*.musicxml
!tests/fixtures/**/*.musicxml
!tests/fixtures/**/*.mxl
!tests/fixtures/**/*.xml
!samples/public_domain/**/*.mid

# 私人研究素材永遠不上傳
samples/private_research/

# Spectra app data
.spectra/

# mypy cache (cross-platform default location)
.mypy_cache/

# Runtime artifacts (auto-engineer / coverage / project lock)
.auto-engineer.pid
.auto-engineer.state.json
.project.lock
.coverage
.coverage.*
htmlcov/
.tmp-test/

# Runtime data directories
data/

# Auto-engineer batch run reports
report.*.json

# Windows crash artifacts
*.stackdump

# KPI gate streak counter (pre-commit hook state)
.kpi-gate-streak
docs/evolve-report-*.md

# Daemon scratch dir — demo/dogfood/trial-pack outputs (probe.txt, pt.txt et al.
# slip past *.pdf/*.zip rules; tracking pollutes git status and risks dragging
# daemon試跑垃圾 into K6 owner push)
.ukepack-tmp/

# Daemon wake timestamp — mutated by harness every restart, never useful diff;
# tracking pollutes git status + reflection snapshot truth (see v154 retro)
.last-restart

# Temporary harness work dirs created by auto-engineer runs (safe to drop)
.git-local
.git-local2
.git-work2
.git-work4
git-local3
.git.bak-verify
.tmp-perm-test
.tmp
.tmp-dry-*.txt
.tmp-wet-*.txt
tmp-wet-*.txt
program.md.bak-*

# auto-dev daemon artifacts + stale index locks — mechanical guard for the
# confirmed auto-salvage-chore-spam anti-pattern (MISSION 反 Pattern #9, 5x).
# These slip past .auto-engineer.* rules (different name) and re-surface in git
# status every wake, feeding bare chore(auto-salvage) commits with no K-tag.
# Ignoring the source stops the daemon from re-discovering them. (evolve 2026-06-04)
.auto-dev.state.json
auto-dev-summary.md
.antigravitycli/
.tmp_*.lock
.tmp-pytest-*/
logs/
.codex-tmp/
